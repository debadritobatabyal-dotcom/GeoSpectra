{
  "dataset": "synthetic_production_dataset_fixed.csv",
  "total_samples": 8000,
  "train_samples": 5992,
  "test_samples": 2008,
  "split_type": "chronological_holdout",
  "train_date_range": [
    "2021-01-01",
    "2023-12-31"
  ],
  "test_date_range": [
    "2024-01-01",
    "2024-12-31"
  ],
  "target_variable": "actual_production_tpd",
  "models": {
    "xgboost": {
      "model_type": "XGBRegressor",
      "hyperparameters": {
        "n_estimators": 250,
        "max_depth": 5,
        "learning_rate": 0.05,
        "subsample": 0.85,
        "colsample_bytree": 0.85,
        "min_child_weight": 3,
        "reg_alpha": 0.1,
        "reg_lambda": 1.0,
        "random_state": 42,
        "n_jobs": -1
      },
      "metrics": {
        "mae": 118.09,
        "rmse": 162.54,
        "r2": 0.9574
      },
      "status": "production_primary"
    },
    "random_forest_benchmark": {
      "model_type": "RandomForestRegressor",
      "hyperparameters": {
        "n_estimators": 150,
        "max_depth": 12,
        "min_samples_leaf": 2,
        "random_state": 42,
        "n_jobs": -1
      },
      "metrics": {
        "mae": 141.16,
        "rmse": 192.85,
        "r2": 0.94
      },
      "status": "benchmark_comparison"
    }
  },
  "features_count": 51,
