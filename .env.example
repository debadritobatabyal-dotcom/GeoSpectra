# ==============================================================================
# Google Earth Engine & System Configuration
# ==============================================================================
# Copy this file to '.env' and set your Google Cloud / Earth Engine project ID.
# To authenticate Earth Engine, run:
#     python3 authenticate_gee.py
#
# Your Google Cloud Project ID with Earth Engine API enabled:
EARTHENGINE_PROJECT=your-google-cloud-project-id

# Optional: Streamlit server configuration overrides
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_HEADLESS=true
